### Phase 5 — Thinking Engine with ReAct Loop (20 min)

**Create `engine/thinking/context-builder.ts`:**

```typescript
import { db } from '../../lib/db.js'
import { agentMemory, positions } from '../../lib/schema.js'
import { eq, desc } from 'drizzle-orm'
import { getPrice } from '../../services/contract.service.js'
import type { MarketContext } from '../types.js'

export async function buildMarketContext(agentId: string): Promise<MarketContext> {
  // Fetch prices from oracle
  const [btc, eth, sol] = await Promise.all([
    getPrice('BTC/USD').catch(() => 0),
    getPrice('ETH/USD').catch(() => 0),
    getPrice('SOL/USD').catch(() => 0),
  ])

  const prices: Record<string, number> = {
    'BTC/USD': btc,
    'ETH/USD': eth,
    'SOL/USD': sol,
  }

  // Fetch recent trades
  const recentTrades = await db.select()
    .from(agentMemory)
    .where(eq(agentMemory.agentId, agentId))
    .orderBy(desc(agentMemory.createdAt))
    .limit(5)

  // Fetch open positions
  const openPositions = await db.select()
    .from(positions)
    .where(eq(positions.agentId, agentId))

  // Calculate today's PnL (simplified)
  const todayPnl = recentTrades.reduce((sum, t) => {
    const pnl = t.metadata ? JSON.parse(t.metadata)?.pnl ?? 0 : 0
    return sum + pnl
  }, 0)

  // Calculate win rate
  const wins = recentTrades.filter(t => {
    const pnl = t.metadata ? JSON.parse(t.metadata)?.pnl ?? 0 : 0
    return pnl > 0
  }).length
  const winRate = recentTrades.length > 0 ? (wins / recentTrades.length) * 100 : 0

  return {
    prices,
    priceChanges: {
      'BTC/USD': { hour: 0, day: 0 }, // TODO: Calculate from historical data
      'ETH/USD': { hour: 0, day: 0 },
      'SOL/USD': { hour: 0, day: 0 },
    },
    recentTrades: recentTrades.map(t => ({
      action: t.type,
      pnl: t.metadata ? JSON.parse(t.metadata)?.pnl ?? 0 : 0,
      timestamp: t.createdAt?.toISOString() ?? new Date().toISOString(),
    })),
    openPositions: openPositions.map(p => ({
      venue: 'perp', // TODO: Get from position
      side: 'long',
      size: Number(p.size),
      entryPrice: Number(p.entryPrice),
    })),
    todayPnl,
    winRate,
    totalTrades: recentTrades.length,
  }
}

export function buildUserPrompt(context: MarketContext): string {
  return `## Current Market Data
${Object.entries(context.prices)
  .map(([pair, price]) => `- ${pair}: $${price.toLocaleString()}`)
  .join('\n')}

## Your Recent Trades
${context.recentTrades.length > 0
  ? context.recentTrades.map(t => `- ${t.action}: ${t.pnl >= 0 ? '+' : ''}$${t.pnl.toFixed(2)} (${t.timestamp})`).join('\n')
  : 'No recent trades'}

## Your Open Positions
${context.openPositions.length > 0
  ? context.openPositions.map(p => `- ${p.venue} ${p.side} $${p.size} @ $${p.entryPrice}`).join('\n')
  : 'No open positions'}

## Your Performance Today
- PnL: ${context.todayPnl >= 0 ? '+' : ''}$${context.todayPnl.toFixed(2)}
- Win Rate: ${context.winRate.toFixed(1)}%
- Total Trades: ${context.totalTrades}

## Task
Analyze the current market conditions and decide if there's a profitable trading opportunity.
If you see a good setup, execute it. If not, HOLD and wait for better conditions.

Remember: You MUST call get_price to verify current prices before any trade.
`
}
```

**Create `engine/thinking/thinking-engine.ts`:**

```typescript
import OpenAI from 'openai'
import type { ThinkingOutput } from '../types.js'
import type { ToolRegistry } from '../tools/registry.js'
import { buildSystemPrompt } from './system-prompt.js'
import { buildMarketContext, buildUserPrompt } from './context-builder.js'

export class ThinkingEngine {
  private client: OpenAI

  constructor(
    private readonly apiKey: string,
    private readonly baseURL: string,
    private readonly model: string,
    private readonly tools: ToolRegistry,
  ) {
    this.client = new OpenAI({ apiKey, baseURL })
  }

  async run(agent: {
    id: string
    name: string
    strategy: string | null
    skills: string | null
    riskConfig: {
      maxLeverage: number
      stopLossPct: number
      spendLimit: number
    }
  }): Promise<ThinkingOutput> {
    // 1. Build context
    const marketContext = await buildMarketContext(agent.id)
    const systemPrompt = buildSystemPrompt(agent)
    const userPrompt = buildUserPrompt(marketContext)

    // 2. ReAct loop — AI can call tools during reasoning
    const messages: OpenAI.ChatCompletionMessageParam[] = [
      { role: 'user', content: userPrompt },
    ]

    const maxIterations = 5
    for (let i = 0; i < maxIterations; i++) {
      const response = await this.client.chat.completions.create({
        model: this.model,
        messages: [
          { role: 'system', content: systemPrompt },
          ...messages,
        ],
        tools: this.tools.getSchemas().map(schema => ({
          type: 'function' as const,
          function: {
            name: schema.name,
            description: schema.description,
            parameters: schema.input_schema,
          },
        })),
        tool_choice: 'auto',
        temperature: 0.7,
        max_tokens: 2048,
      })

      const choice = response.choices[0]
      if (!choice) throw new Error('No response from AI')

      const message = choice.message

      // 3. If AI wants to call a tool
      if (message.tool_calls && message.tool_calls.length > 0) {
        // Add assistant message with tool calls
        messages.push(message)

        // Execute each tool and add results
        for (const toolCall of message.tool_calls) {
          const result = await this.tools.execute(
            toolCall.function.name,
            JSON.parse(toolCall.function.arguments),
          )

          messages.push({
            role: 'tool',
            tool_call_id: toolCall.id,
            content: JSON.stringify(result),
          })
        }

        // Continue the loop — AI will see tool results and decide next
        continue
      }

      // 4. If AI is done (no more tool calls), parse the final response
      const content = message.content ?? '{}'
      const parsed = this.parseResponse(content)

      return parsed
    }

    throw new Error('ReAct loop exceeded max iterations')
  }

  private parseResponse(content: string): ThinkingOutput {
    // Try to extract JSON from the response
    let jsonStr = content

    // Remove markdown code blocks if present
    const jsonMatch = content.match(/```(?:json)?\s*([\s\S]*?)```/)
    if (jsonMatch) {
      jsonStr = jsonMatch[1]
    }

    // Try to find JSON object
    const objectMatch = jsonStr.match(/\{[\s\S]*\}/)
    if (objectMatch) {
      jsonStr = objectMatch[0]
    }

    try {
      const parsed = JSON.parse(jsonStr)
      return {
        observation: parsed.observation ?? '',
        analysis: parsed.analysis ?? '',
        action: parsed.action ?? 'hold',
        tool: parsed.tool ?? null,
        args: parsed.args ?? null,
        confidence: parsed.confidence ?? 0,
        riskLevel: parsed.riskLevel ?? 'medium',
        reasoning: parsed.reasoning ?? '',
        abortConditions: parsed.abortConditions ?? [],
      }
    } catch {
      // If JSON parsing fails, return a HOLD decision
      console.warn('Failed to parse AI response, defaulting to HOLD')
      return {
        observation: 'Failed to parse response',
        analysis: content,
        action: 'hold',
        tool: null,
        args: null,
        confidence: 0,
        riskLevel: 'low',
        reasoning: 'Response parsing failed, defaulting to HOLD for safety',
        abortConditions: [],
      }
    }
  }
}
```

---

### Phase 6 — Agent Loop Wiring (15 min)

**Create `engine/agent-loop.ts`:**

```typescript
import { db } from '../lib/db.js'
import { agents, agentMemory, feedEvents } from '../lib/schema.js'
import { eq } from 'drizzle-orm'
import { ThinkingEngine } from './thinking/thinking-engine.js'
import { DecisionEngine } from './decision/decision-engine.js'
import { ToolRegistry } from './tools/registry.js'
import { broadcastAgentEvent } from '../services/ws.js'
import type { EngineConfig, RiskConfig } from './types.js'

// Default risk config
const DEFAULT_RISK_CONFIG: RiskConfig = {
  maxLeverageX: 5,
  stopLossPct: 10,
  spendLimitUsd: 100,
  maxDailyLossUsd: 50,
  pauseOnConsecutiveLosses: 3,
  cooldownMinutes: 30,
  confidenceThresholds: {
    low: 55,
    medium: 70,
    high: 85,
  },
}

export class AgentEngine {
  private thinking: ThinkingEngine
  private decision: DecisionEngine
  private tools: ToolRegistry
  private isRunning = false

  constructor(
    private readonly config: EngineConfig,
    aiApiKey: string,
    aiBaseURL: string,
    aiModel: string,
  ) {
    // Initialize tools
    this.tools = new ToolRegistry()
    // Register tools here (imported from ./tools/)
    // this.tools.register(getPriceTool)
    // this.tools.register(openTradeTool)
    // this.tools.register(closeTradeTool)

    // Initialize thinking engine
    this.thinking = new ThinkingEngine(aiApiKey, aiBaseURL, aiModel, this.tools)

    // Initialize decision engine
    this.decision = new DecisionEngine(DEFAULT_RISK_CONFIG)
  }

  async runAgentCycle(agentId: string): Promise<void> {
    // 1. Load agent
    const agent = await db.query.agents.findFirst({
      where: eq(agents.id, agentId),
    })

    if (!agent || agent.status !== 'active') {
      return
    }

    console.log(`\n${'─'.repeat(50)}`)
    console.log(`🔄 [${agent.name}] Cycle started`)

    // 2. Broadcast thinking start
    broadcastAgentEvent(agentId, {
      type: 'thinking_start',
      timestamp: new Date().toISOString(),
    })

    try {
      // 3. Think (ReAct loop — AI can call tools mid-reasoning)
      const thinkingOutput = await this.thinking.run({
        id: agent.id,
        name: agent.name,
        strategy: agent.strategy,
        skills: agent.skills,
        riskConfig: {
          maxLeverage: agent.maxLeverage ?? 5,
          stopLossPct: agent.stopLossPct ?? 10,
          spendLimit: agent.spendLimit ?? 100,
        },
      })

      // 4. Store reasoning in memory
      await db.insert(agentMemory).values({
        id: crypto.randomUUID(),
        agentId,
        type: 'reasoning',
        content: thinkingOutput.reasoning,
        reasoning: thinkingOutput.observation + '\n\n' + thinkingOutput.analysis,
        metadata: JSON.stringify({
          confidence: thinkingOutput.confidence,
          riskLevel: thinkingOutput.riskLevel,
        }),
      })

      // 5. Broadcast thinking result
      broadcastAgentEvent(agentId, {
        type: 'thinking_result',
        data: {
          observation: thinkingOutput.observation,
          analysis: thinkingOutput.analysis,
          confidence: thinkingOutput.confidence,
          riskLevel: thinkingOutput.riskLevel,
        },
        timestamp: new Date().toISOString(),
      })

      console.log(`   🧠 Observation: ${thinkingOutput.observation.slice(0, 100)}...`)
      console.log(`   📊 Confidence: ${thinkingOutput.confidence}% | Risk: ${thinkingOutput.riskLevel}`)

      // 6. Evaluate decision (risk gates + circuit breaker)
      const tradeDecision = this.decision.evaluate(thinkingOutput, {
        maxLeverageX: agent.maxLeverage ?? 5,
        spendLimitUsd: agent.spendLimit ?? 100,
      })

      if (!tradeDecision) {
        console.log(`   ⏭️  No action taken (blocked by decision engine)`)
        return
      }

      // 7. Execute tool
      console.log(`   ⚡ Executing: ${tradeDecision.tool}`)
      const result = await this.tools.execute(tradeDecision.tool, tradeDecision.args)

      // 8. Store execution in memory
      await db.insert(agentMemory).values({
        id: crypto.randomUUID(),
        agentId,
        type: 'execution',
        content: `Executed ${tradeDecision.tool}: ${JSON.stringify(result)}`,
        reasoning: tradeDecision.reasoning,
        metadata: JSON.stringify({
          tool: tradeDecision.tool,
          args: tradeDecision.args,
          result,
        }),
      })

      // 9. Create feed event
      await db.insert(feedEvents).values({
        id: crypto.randomUUID(),
        agentId,
        type: tradeDecision.tool === 'open_trade' ? 'position_opened' : 'position_closed',
        venue: tradeDecision.args.venue as string ?? 'unknown',
        pair: tradeDecision.args.pair as string ?? 'unknown',
        side: tradeDecision.args.side as string ?? 'unknown',
        size: tradeDecision.args.size as string ?? '0',
        metadata: JSON.stringify({
          confidence: tradeDecision.confidence,
          reasoning: tradeDecision.reasoning,
          abortConditions: tradeDecision.abortConditions,
        }),
      })

      // 10. Broadcast execution
      broadcastAgentEvent(agentId, {
        type: 'execution',
        data: {
          tool: tradeDecision.tool,
          args: tradeDecision.args,
          result,
        },
        timestamp: new Date().toISOString(),
      })

      console.log(`   ✅ Execution complete`)
    } catch (error) {
      console.error(`   ❌ Error:`, error)
      broadcastAgentEvent(agentId, {
        type: 'error',
        data: { error: String(error) },
        timestamp: new Date().toISOString(),
      })
    }
  }

  start(): void {
    if (this.isRunning) return
    this.isRunning = true

    console.log(`🚀 Engine started — cycling every ${this.config.cycleIntervalMs}ms`)

    // Main loop
    setInterval(async () => {
      try {
        // Load all active agents
        const activeAgents = await db.query.agents.findMany({
          where: eq(agents.status, 'active'),
        })

        // Process each agent
        for (const agent of activeAgents.slice(0, this.config.maxAgentsPerCycle)) {
          await this.runAgentCycle(agent.id)
        }
      } catch (error) {
        console.error('Engine cycle error:', error)
      }
    }, this.config.cycleIntervalMs)
  }

  stop(): void {
    this.isRunning = false
    console.log('⏹️ Engine stopped')
  }
}
```

**Update `engine/index.ts`:**

```typescript
import { AgentEngine } from './agent-loop.js'
import type { EngineConfig } from './types.js'

let engine: AgentEngine | null = null

export function startEngine(config?: Partial<EngineConfig>): void {
  const cfg: EngineConfig = {
    cycleIntervalMs: 10_000,
    maxAgentsPerCycle: 20,
    memoryContextSize: 5,
    ...config,
  }

  const apiKey = process.env.AI_API_KEY ?? process.env.OPENAI_API_KEY ?? ''
  const baseURL = process.env.AI_BASE_URL ?? 'https://api.openai.com/v1'
  const model = process.env.AI_MODEL ?? 'gpt-4o'

  engine = new AgentEngine(cfg, apiKey, baseURL, model)
  engine.start()
}

export function stopEngine(): void {
  engine?.stop()
  engine = null
}

export async function runAgentNow(agentId: string): Promise<void> {
  if (!engine) throw new Error('Engine not started')
  await engine.runAgentCycle(agentId)
}
```

