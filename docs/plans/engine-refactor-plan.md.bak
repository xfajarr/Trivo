## Phase 2.8 — Semantic Memory with Embeddings (20 min)

### What This Does

Uses Heurist's embedding API to store memories as vectors. When the AI needs context, it searches for semantically similar memories instead of just loading the last 5.

### Architecture

```
Trade happens
    ↓
Store memory with embedding
    ↓
Heurist Embedding API → vector
    ↓
Save to PostgreSQL (pgvector) or in-memory

Next decision:
    ↓
Query: "What happened last time BTC was at $103k?"
    ↓
Embed query → search similar vectors
    ↓
Return top 5 most relevant memories
```

### Implementation

**Create `engine/memory/semantic-memory.ts`:**

```typescript
import { HeuristProvider } from '../providers/heurist.js'
import { db } from '../../lib/db.js'
import { agentMemory } from '../../lib/schema.js'
import { eq, desc } from 'drizzle-orm'

interface MemoryEntry {
  id: string
  content: string
  type: string
  embedding: number[]
  metadata: Record<string, unknown>
  createdAt: Date
}

export class SemanticMemory {
  private embeddingCache = new Map<string, number[]>()

  constructor(private readonly heurist: HeuristProvider) {}

  // Store memory with embedding
  async store(agentId: string, type: string, content: string, metadata?: Record<string, unknown>): Promise<void> {
    const embedding = await this.getEmbedding(content)

    await db.insert(agentMemory).values({
      id: crypto.randomUUID(),
      agentId,
      type,
      content,
      reasoning: null,
      metadata: JSON.stringify({
        ...metadata,
        embedding: embedding.slice(0, 50), // Store first 50 dims for debugging
      }),
    })
  }

  // Search for similar memories
  async searchSimilar(agentId: string, query: string, limit: number = 5): Promise<MemoryEntry[]> {
    const queryEmbedding = await this.getEmbedding(query)

    // Get all memories for this agent
    const memories = await db.select()
      .from(agentMemory)
      .where(eq(agentMemory.agentId, agentId))
      .orderBy(desc(agentMemory.createdAt))
      .limit(100) // Get recent 100 to search through

    // Calculate cosine similarity
    const scored = memories
      .map(m => {
        const meta = m.metadata ? JSON.parse(m.metadata) : {}
        const memEmbedding = meta.embedding as number[] | undefined

        if (!memEmbedding) return null

        const similarity = this.cosineSimilarity(queryEmbedding, memEmbedding)
        return {
          id: m.id,
          content: m.content,
          type: m.type,
          embedding: memEmbedding,
          metadata: meta,
          createdAt: m.createdAt ?? new Date(),
          similarity,
        }
      })
      .filter((m): m is NonNullable<typeof m> => m !== null)
      .sort((a, b) => b.similarity - a.similarity)
      .slice(0, limit)

    return scored
  }

  // Get or compute embedding
  private async getEmbedding(text: string): Promise<number[]> {
    const cached = this.embeddingCache.get(text)
    if (cached) return cached

    const embedding = await this.heurist.createEmbedding(text)
    this.embeddingCache.set(text, embedding)

    // Keep cache size manageable
    if (this.embeddingCache.size > 1000) {
      const firstKey = this.embeddingCache.keys().next().value
      if (firstKey) this.embeddingCache.delete(firstKey)
    }

    return embedding
  }

  // Cosine similarity between two vectors
  private cosineSimilarity(a: number[], b: number[]): number {
    if (a.length !== b.length) return 0

    let dotProduct = 0
    let normA = 0
    let normB = 0

    for (let i = 0; i < a.length; i++) {
      dotProduct += a[i] * b[i]
      normA += a[i] * a[i]
      normB += b[i] * b[i]
    }

    return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB))
  }
}
```

**Update `engine/thinking/context-builder.ts` to use semantic search:**

```typescript
import { SemanticMemory } from '../memory/semantic-memory.js'

export async function buildContextWithSemanticSearch(
  agentId: string,
  semanticMemory: SemanticMemory,
  currentMarketState: string,
): Promise<string> {
  // Search for similar past situations
  const similarMemories = await semanticMemory.searchSimilar(
    agentId,
    currentMarketState,
    5,
  )

  // Format memories
  const memoriesStr = similarMemories
    .map(m => `[${m.type}] ${m.content} (similarity: ${(m as any).similarity.toFixed(2)})`)
    .join('\n')

  return `
## Similar Past Situations
${memoriesStr || 'No similar memories found'}

## Current Market State
${currentMarketState}

Use the similar past situations to inform your decision. If a similar setup worked before, consider repeating it. If it failed, avoid it.
`
}
```

