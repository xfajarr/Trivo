## Additional Improvements for Better AI

### 1. Streaming Responses (Better UX)

```typescript
// In thinking-engine.ts
async runWithStreaming(
  agent: AgentConfig,
  onToken: (token: string) => void,
): Promise<ThinkingOutput> {
  const stream = await this.client.chat.completions.create({
    model: this.model,
    messages: [...],
    stream: true,
  })

  let fullContent = ''
  for await (const chunk of stream) {
    const content = chunk.choices[0]?.delta?.content ?? ''
    fullContent += content
    onToken(content) // Send to WebSocket for real-time display
  }

  return this.parseResponse(fullContent)
}
```

### 2. Retry Logic with Exponential Backoff

```typescript
// In provider base class
async withRetry<T>(fn: () => Promise<T>, maxRetries: number = 3): Promise<T> {
  for (let i = 0; i < maxRetries; i++) {
    try {
      return await fn()
    } catch (error) {
      if (i === maxRetries - 1) throw error
      const delay = Math.pow(2, i) * 1000 // 1s, 2s, 4s
      console.log(`Retry ${i + 1}/${maxRetries} after ${delay}ms`)
      await new Promise(resolve => setTimeout(resolve, delay))
    }
  }
  throw new Error('Max retries exceeded')
}
```

### 3. Tool Result Caching

```typescript
// In tool registry
private resultCache = new Map<string, { result: unknown; expires: number }>()

async executeWithCache(name: string, args: Record<string, unknown>, ttlMs: number = 30000): Promise<unknown> {
  const cacheKey = `${name}:${JSON.stringify(args)}`
  const cached = this.resultCache.get(cacheKey)

  if (cached && cached.expires > Date.now()) {
    return cached.result
  }

  const result = await this.execute(name, args)
  this.resultCache.set(cacheKey, { result, expires: Date.now() + ttlMs })
  return result
}
```

### 4. Confidence Calibration

```typescript
// Track historical accuracy per confidence level
interface ConfidenceTracker {
  predictions: Array<{ confidence: number; correct: boolean }>
  
  getCalibratedConfidence(rawConfidence: number): number {
    const relevant = this.predictions.filter(
      p => Math.abs(p.confidence - rawConfidence) < 10
    )
    if (relevant.length < 5) return rawConfidence
    
    const accuracy = relevant.filter(p => p.correct).length / relevant.length
    return Math.round(accuracy * 100)
  }
}
```

### 5. Decision History & Learning

```typescript
// Track which decisions led to profits
interface DecisionTracker {
  decisions: Array<{
    reasoning: string
    action: string
    confidence: number
    pnl: number
    timestamp: Date
  }>

  getBestPractices(): string[] {
    const profitable = this.decisions.filter(d => d.pnl > 0)
    // Extract patterns from profitable decisions
    return profitable.map(d => d.reasoning).slice(0, 10)
  }

  getMistakes(): string[] {
    const unprofitable = this.decisions.filter(d => d.pnl < 0)
    return unprofitable.map(d => d.reasoning).slice(0, 10)
  }
}
```

