### Integration Points

#### 1. Agent Creation Flow

```typescript
// In routes/agents.ts - POST /api/agents
async function createAgent(req, res) {
  const { name, strategy, skills, riskParams } = req.body

  // 1. Create metadata
  const metadata = erc8004Service.createAgentMetadata({
    name,
    description: strategy,
    strategy,
    skills: skills.split(','),
    riskParams: JSON.parse(riskParams),
  })

  // 2. Upload to IPFS (or data URI)
  const metadataURI = await erc8004Service.uploadMetadata(metadata)

  // 3. Register on ERC-8004
  const { agentId, txHash } = await erc8004Service.registerAgent(metadataURI)

  // 4. Save to DB
  const agent = await db.insert(agents).values({
    id: crypto.randomUUID(),
    name,
    strategy,
    skills,
    identityTokenId: agentId,      // NEW: ERC-8004 agent ID
    identityTxHash: txHash,         // NEW: registration tx hash
    metadataURI,                    // NEW: IPFS/data URI
    // ... other fields
  }).returning()

  return { agent, erc8004: { agentId, txHash, metadataURI } }
}
```

#### 2. Trade Execution Flow

```typescript
// In engine/agent-loop.ts - after trade execution
async function recordTradeOutcome(agentId: string, isWin: boolean) {
  // Get agent's ERC-8004 identity
  const agent = await db.query.agents.findFirst({
    where: eq(agents.id, agentId),
  })

  if (!agent?.identityTokenId) {
    console.warn(`Agent ${agentId} has no ERC-8004 identity`)
    return
  }

  // Record on ReputationRegistry
  const txHash = await erc8004Service.recordTradeOutcome(
    agent.identityTokenId,
    isWin,
  )

  console.log(`📊 Recorded trade outcome for agent ${agentId}: ${isWin ? 'WIN' : 'LOSS'}`)
  console.log(`   ERC-8004 reputation tx: https://testnet.arcscan.app/tx/${txHash}`)
}
```

#### 3. Agent Profile Display

```typescript
// In routes/agents.ts - GET /api/agents/:id
async function getAgent(req, res) {
  const agent = await db.query.agents.findFirst({
    where: eq(agents.id, req.params.id),
  })

  // Get ERC-8004 identity from chain
  let erc8004Identity = null
  if (agent.identityTokenId) {
    erc8004Identity = await erc8004Service.getAgentIdentity(agent.identityTokenId)
  }

  return {
    ...agent,
    erc8004: erc8004Identity,
    // Frontend can show: "ERC-8004 Agent #123 · Verified on Arc"
  }
}
```

### Database Changes

Add to `agents` table:

```sql
ALTER TABLE agents ADD COLUMN identity_token_id VARCHAR(78);   -- ERC-8004 tokenId
ALTER TABLE agents ADD COLUMN identity_tx_hash VARCHAR(66);    -- Registration tx hash
ALTER TABLE agents ADD COLUMN metadata_uri TEXT;                -- IPFS or data URI
```

