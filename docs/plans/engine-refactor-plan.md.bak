## Phase 2.7 — ASI:One + Heurist AI Provider Integration (25 min)

### Provider Comparison

| Feature           | ASI:One                               | Heurist AI                |
| ----------------- | ------------------------------------- | ------------------------- |
| **Tool Calling**      | ✅ Full OpenAI compat                 | ✅ Full OpenAI compat     |
| **Best Model**        | `asi1-ultra` (500 tool calls/turn!) | `hermes-3-llama3.1-8b`  |
| **Context Window**    | 200k tokens                           | Standard                  |
| **Session Mgmt**      | ✅ `x-session-id` header              | ❌ No                     |
| **Embeddings**        | ❌ No                                 | ✅ `BAAI/bge-large-en-v1.5` |
| **Streaming**         | ✅ Yes                                | ✅ Yes                    |
| **Cost**              | Mid-High                              | Low                       |
| **Agentic**           | ✅ Agentverse integration             | ❌ No                     |
| **Best For**          | Deep reasoning, complex agentic flows | Fast inference, embeddings |

### Strategy: Multi-Model Cascade

Use different models for different tasks:

```
┌─────────────────────────────────────────────────────────────┐
│                    MODEL ROUTER                              │
├─────────────────────────────────────────────────────────────┤
│  Simple tasks (get_price, quick decisions)                   │
│  → asi1-mini (fastest, cheapest)                             │
│                                                              │
│  Standard trading decisions                                  │
│  → asi1 (balanced) or heurist/hermes-3-llama3.1-8b (cheap)  │
│                                                              │
│  Complex reasoning (multi-step analysis, strategy)           │
│  → asi1-ultra (500 tool calls, deepest reasoning)            │
│                                                              │
│  Memory embeddings (semantic search)                         │
│  → Heurist embeddings (BAAI/bge-large-en-v1.5)              │
└─────────────────────────────────────────────────────────────┘
```

### Implementation

**Create `engine/providers/asi-one.ts`:**

```typescript
import OpenAI from 'openai'
import type { ThinkingOutput } from '../types.js'
import type { ToolRegistry } from '../tools/registry.js'

interface ASIOneConfig {
  apiKey: string
  model: 'asi1' | 'asi1-ultra' | 'asi1-mini'
}

export class ASIOneProvider {
  private client: OpenAI
  private model: string
  private sessionId: string | null = null

  constructor(config: ASIOneConfig) {
    this.client = new OpenAI({
      apiKey: config.apiKey,
      baseURL: 'https://api.asi1.ai/v1',
    })
    this.model = config.model
  }

  // Session persistence for multi-turn conversations
  setSessionId(sessionId: string): void {
    this.sessionId = sessionId
  }

  async runReActLoop(
    systemPrompt: string,
    userPrompt: string,
    tools: ToolRegistry,
    maxIterations: number = 10,
  ): Promise<ThinkingOutput> {
    const messages: OpenAI.ChatCompletionMessageParam[] = [
      { role: 'user', content: userPrompt },
    ]

    const headers: Record<string, string> = {}
    if (this.sessionId) {
      headers['x-session-id'] = this.sessionId
    }

    for (let i = 0; i < maxIterations; i++) {
      const response = await this.client.chat.completions.create({
        model: this.model,
        messages: [
          { role: 'system', content: systemPrompt },
          ...messages,
        ],
        tools: tools.getSchemas().map(schema => ({
          type: 'function' as const,
          function: {
            name: schema.name,
            description: schema.description,
            parameters: schema.input_schema,
          },
        })),
        tool_choice: 'auto',
        temperature: 0.7,
        max_tokens: 4096,
      }, { headers })

      const choice = response.choices[0]
      if (!choice) throw new Error('No response from ASI:One')

      const message = choice.message

      // If AI wants to call tools
      if (message.tool_calls && message.tool_calls.length > 0) {
        messages.push(message)

        // Execute tools (can be parallel with ASI:One)
        for (const toolCall of message.tool_calls) {
          try {
            const result = await tools.execute(
              toolCall.function.name,
              JSON.parse(toolCall.function.arguments),
            )
            messages.push({
              role: 'tool',
              tool_call_id: toolCall.id,
              content: JSON.stringify(result),
            })
          } catch (error) {
            messages.push({
              role: 'tool',
              tool_call_id: toolCall.id,
              content: JSON.stringify({ error: String(error) }),
            })
          }
        }
        continue
      }

      // Parse final response
      return this.parseResponse(message.content ?? '{}')
    }

    throw new Error('ASI:One ReAct loop exceeded max iterations')
  }

  private parseResponse(content: string): ThinkingOutput {
    let jsonStr = content
    const jsonMatch = content.match(/```(?:json)?\s*([\s\S]*?)```/)
    if (jsonMatch) jsonStr = jsonMatch[1]
    const objectMatch = jsonStr.match(/\{[\s\S]*\}/)
    if (objectMatch) jsonStr = objectMatch[0]

    try {
      const parsed = JSON.parse(jsonStr)
      return {
        observation: parsed.observation ?? '',
        analysis: parsed.analysis ?? '',
        action: parsed.action ?? 'hold',
        tool: parsed.tool ?? null,
        args: parsed.args ?? null,
        confidence: parsed.confidence ?? 0,
        riskLevel: parsed.riskLevel ?? 'medium',
        reasoning: parsed.reasoning ?? '',
        abortConditions: parsed.abortConditions ?? [],
      }
    } catch {
      return {
        observation: 'Failed to parse response',
        analysis: content,
        action: 'hold',
        tool: null,
        args: null,
        confidence: 0,
        riskLevel: 'low',
        reasoning: 'Response parsing failed',
        abortConditions: [],
      }
    }
  }
}
```

**Create `engine/providers/heurist.ts`:**

```typescript
import OpenAI from 'openai'
import type { ThinkingOutput } from '../types.js'
import type { ToolRegistry } from '../tools/registry.js'

interface HeuristConfig {
  apiKey: string
  model: string  // e.g., 'hermes-3-llama3.1-8b'
}

export class HeuristProvider {
  private client: OpenAI
  private model: string

  constructor(config: HeuristConfig) {
    this.client = new OpenAI({
      apiKey: config.apiKey,
      baseURL: 'https://llm-gateway.heurist.xyz',
    })
    this.model = config.model
  }

  async runReActLoop(
    systemPrompt: string,
    userPrompt: string,
    tools: ToolRegistry,
    maxIterations: number = 5,
  ): Promise<ThinkingOutput> {
    const messages: OpenAI.ChatCompletionMessageParam[] = [
      { role: 'user', content: userPrompt },
    ]

    for (let i = 0; i < maxIterations; i++) {
      const response = await this.client.chat.completions.create({
        model: this.model,
        messages: [
          { role: 'system', content: systemPrompt },
          ...messages,
        ],
        tools: tools.getSchemas().map(schema => ({
          type: 'function' as const,
          function: {
            name: schema.name,
            description: schema.description,
            parameters: schema.input_schema,
          },
        })),
        tool_choice: 'auto',
        temperature: 0.7,
        max_tokens: 2048,
      })

      const choice = response.choices[0]
      if (!choice) throw new Error('No response from Heurist')

      const message = choice.message

      if (message.tool_calls && message.tool_calls.length > 0) {
        messages.push(message)

        for (const toolCall of message.tool_calls) {
          try {
            const result = await tools.execute(
              toolCall.function.name,
              JSON.parse(toolCall.function.arguments),
            )
            messages.push({
              role: 'tool',
              tool_call_id: toolCall.id,
              content: JSON.stringify(result),
            })
          } catch (error) {
            messages.push({
              role: 'tool',
              tool_call_id: toolCall.id,
              content: JSON.stringify({ error: String(error) }),
            })
          }
        }
        continue
      }

      return this.parseResponse(message.content ?? '{}')
    }

    throw new Error('Heurist ReAct loop exceeded max iterations')
  }

  // Embedding API for semantic memory
  async createEmbedding(text: string): Promise<number[]> {
    const response = await this.client.embeddings.create({
      model: 'BAAI/bge-large-en-v1.5',
      input: text,
      encoding_format: 'float',
    })
    return response.data[0].embedding
  }

  async createEmbeddings(texts: string[]): Promise<number[][]> {
    const response = await this.client.embeddings.create({
      model: 'BAAI/bge-large-en-v1.5',
      input: texts,
      encoding_format: 'float',
    })
    return response.data.map(d => d.embedding)
  }

  private parseResponse(content: string): ThinkingOutput {
    let jsonStr = content
    const jsonMatch = content.match(/```(?:json)?\s*([\s\S]*?)```/)
    if (jsonMatch) jsonStr = jsonMatch[1]
    const objectMatch = jsonStr.match(/\{[\s\S]*\}/)
    if (objectMatch) jsonStr = objectMatch[0]

    try {
      const parsed = JSON.parse(jsonStr)
      return {
        observation: parsed.observation ?? '',
        analysis: parsed.analysis ?? '',
        action: parsed.action ?? 'hold',
        tool: parsed.tool ?? null,
        args: parsed.args ?? null,
        confidence: parsed.confidence ?? 0,
        riskLevel: parsed.riskLevel ?? 'medium',
        reasoning: parsed.reasoning ?? '',
        abortConditions: parsed.abortConditions ?? [],
      }
    } catch {
      return {
        observation: 'Failed to parse response',
        analysis: content,
        action: 'hold',
        tool: null,
        args: null,
        confidence: 0,
        riskLevel: 'low',
        reasoning: 'Response parsing failed',
        abortConditions: [],
      }
    }
  }
}
```

**Create `engine/providers/model-router.ts`:**

```typescript
import { ASIOneProvider } from './asi-one.js'
import { HeuristProvider } from './heurist.js'
import type { ThinkingOutput } from '../types.js'
import type { ToolRegistry } from '../tools/registry.js'

export type ProviderType = 'asi-one' | 'heurist'
export type ASIModel = 'asi1' | 'asi1-ultra' | 'asi1-mini'

interface ModelRouterConfig {
  asiOne?: { apiKey: string }
  heurist?: { apiKey: string }
  defaultProvider: ProviderType
  defaultASIModel: ASIModel
  defaultHeuristModel: string
}

export class ModelRouter {
  private asiOne: ASIOneProvider | null = null
  private heurist: HeuristProvider | null = null

  constructor(private readonly config: ModelRouterConfig) {
    if (config.asiOne) {
      this.asiOne = new ASIOneProvider({
        apiKey: config.asiOne.apiKey,
        model: config.defaultASIModel,
      })
    }
    if (config.heurist) {
      this.heurist = new HeuristProvider({
        apiKey: config.heurist.apiKey,
        model: config.defaultHeuristModel,
      })
    }
  }

  // Get provider based on task complexity
  getProvider(taskComplexity: 'simple' | 'standard' | 'complex'): ASIOneProvider | HeuristProvider {
    switch (taskComplexity) {
      case 'simple':
        // Use asi1-mini for simple tasks (fast, cheap)
        if (this.asiOne) {
          this.asiOne = new ASIOneProvider({
            apiKey: this.config.asiOne!.apiKey,
            model: 'asi1-mini',
          })
          return this.asiOne
        }
        return this.heurist!

      case 'complex':
        // Use asi1-ultra for complex reasoning (500 tool calls)
        if (this.asiOne) {
          this.asiOne = new ASIOneProvider({
            apiKey: this.config.asiOne!.apiKey,
            model: 'asi1-ultra',
          })
          return this.asiOne
        }
        return this.heurist!

      case 'standard':
      default:
        // Use default provider
        if (this.config.defaultProvider === 'asi-one' && this.asiOne) {
          return this.asiOne
        }
        return this.heurist!
    }
  }

  // Get embeddings provider (Heurist only)
  getEmbeddingProvider(): HeuristProvider {
    if (!this.heurist) {
      throw new Error('Heurist provider not configured — needed for embeddings')
    }
    return this.heurist
  }

  // Run with automatic provider selection
  async run(
    systemPrompt: string,
    userPrompt: string,
    tools: ToolRegistry,
    taskComplexity: 'simple' | 'standard' | 'complex' = 'standard',
  ): Promise<ThinkingOutput> {
    const provider = this.getProvider(taskComplexity)
    return provider.runReActLoop(systemPrompt, userPrompt, tools)
  }
}
```

