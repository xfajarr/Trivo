export const openTradeTool: EngineTool = {
  schema: {
    name: 'open_trade',
    description: 'Open a new trading position. Use this when you identify a profitable opportunity. Always check price first with get_price.',
    input_schema: {
      type: 'object',
      properties: {
        venue: {
          type: 'string',
          enum: ['perp', 'polymarket', 'lp'],
          description: 'Trading venue: perp (perpetual futures), polymarket (prediction market), lp (liquidity provision)',
        },
        pair: {
          type: 'string',
          description: 'Trading pair (e.g., "BTC/USD")',
        },
        side: {
          type: 'string',
          enum: ['long', 'short'],
          description: 'Position direction',
        },
        size: {
          type: 'number',
          description: 'Position size in USD',
        },
        leverage: {
          type: 'number',
          description: 'Leverage multiplier (1-10)',
        },
      },
      required: ['venue', 'pair', 'side', 'size'],
    },
  },
  async execute(args) {
    const { venue, pair, side, size, leverage = 1 } = args as {
      venue: string
      pair: string
      side: string
      size: number
      leverage?: number
    }

    // Execute on-chain (mock)
    const txHash = `0x${Date.now().toString(16)}...` // Mock tx hash
    
    // Save to DB
    const position = await db.insert(positions).values({
      id: crypto.randomUUID(),
      // ... position data
    }).returning()

    // Create feed event
    await db.insert(feedEvents).values({
      id: crypto.randomUUID(),
      type: 'position_opened',
      // ... event data
    })

    return {
      success: true,
      txHash,
      positionId: position[0]?.id,
      venue,
      pair,
      side,
      size,
      leverage,
    }
  },
}
