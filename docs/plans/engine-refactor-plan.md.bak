## Phase 2.5 — X/Twitter Sentiment Analysis (20 min)

### What This Does

Adds a `get_sentiment` tool that the AI can call during reasoning to check real-time market sentiment from Twitter/X. This is Trivo's version of Moss's X Signal.

### Architecture

```
User tweets about BTC
        ↓
Twitter API / Sentiment API
        ↓
Sentiment Analysis (AI-powered)
        ↓
get_sentiment tool → AI reasoning
        ↓
Better trading decisions
```

### Implementation

**Create `engine/tools/get-sentiment.ts`:**

```typescript
import type { EngineTool, ToolSchema } from './registry.js'

interface SentimentData {
  token: string
  sentiment: 'bullish' | 'bearish' | 'neutral'
  score: number              // -100 to +100
  volume: number             // Number of tweets analyzed
  engagement: number         // Total likes/retweets
  topTopics: string[]        // Trending topics
  influentialTweets: Array<{
    text: string
    author: string
    followers: number
    sentiment: 'bullish' | 'bearish' | 'neutral'
  }>
  timestamp: string
}

// Cache to avoid hitting API limits
const sentimentCache = new Map<string, { data: SentimentData; expires: number }>()
const CACHE_TTL = 5 * 60 * 1000 // 5 minutes

export const getSentimentTool: EngineTool = {
  schema: {
    name: 'get_sentiment',
    description: 'Get real-time Twitter/X sentiment for a crypto token. Use this to gauge market mood before trading. High bullish sentiment with low volume = potential pump. High bearish sentiment = potential dump.',
    input_schema: {
      type: 'object',
      properties: {
        token: {
          type: 'string',
          description: 'Token symbol (e.g., "BTC", "ETH", "SOL") or search term',
        },
        timeframe: {
          type: 'string',
          enum: ['1h', '4h', '24h'],
          description: 'How far back to analyze (default: 4h)',
        },
      },
      required: ['token'],
    },
  },
  async execute(args) {
    const { token, timeframe = '4h' } = args as { token: string; timeframe?: string }
    const cacheKey = `${token}_${timeframe}`

    // Check cache
    const cached = sentimentCache.get(cacheKey)
    if (cached && cached.expires > Date.now()) {
      console.log(`📊 Sentiment cache hit for ${token}`)
      return cached.data
    }

    // Fetch fresh sentiment
    const sentiment = await fetchTwitterSentiment(token, timeframe)

    // Cache the result
    sentimentCache.set(cacheKey, {
      data: sentiment,
      expires: Date.now() + CACHE_TTL,
    })

    return sentiment
  },
}

async function fetchTwitterSentiment(token: string, timeframe: string): Promise<SentimentData> {
  // Option 1: Use Twitter API v2 (requires API key)
  // Option 2: Use third-party API (LunarCrush, Santiment, The TIE)
  // Option 3: Use AI to analyze recent tweets (hackathon-friendly)

  // For hackathon, we'll use a simulated approach
  // In production, integrate with real API

  const searchQuery = `#${token} OR $${token} OR ${token}crypto`
  
  // Simulated sentiment analysis
  // Replace with real API call in production
  const sentiment = await analyzeSentimentWithAI(searchQuery, timeframe)

  return {
    token,
    sentiment: sentiment.score > 20 ? 'bullish' : sentiment.score < -20 ? 'bearish' : 'neutral',
    score: sentiment.score,
    volume: sentiment.tweetCount,
    engagement: sentiment.totalEngagement,
    topTopics: sentiment.topics,
    influentialTweets: sentiment.topTweets,
    timestamp: new Date().toISOString(),
  }
}

async function analyzeSentimentWithAI(
  searchQuery: string,
  timeframe: string,
): Promise<{
  score: number
  tweetCount: number
  totalEngagement: number
  topics: string[]
  topTweets: Array<{ text: string; author: string; followers: number; sentiment: string }>
}> {
  // In production, this would:
  // 1. Fetch tweets from Twitter API
  // 2. Analyze sentiment using AI
  // 3. Calculate aggregate score

  // For hackathon, return simulated data
  // Replace with real implementation
  return {
    score: Math.floor(Math.random() * 100) - 50, // -50 to +50
    tweetCount: Math.floor(Math.random() * 1000) + 100,
    totalEngagement: Math.floor(Math.random() * 10000),
    topics: ['bullish', 'moon', 'pump', 'buy'],
    topTweets: [
      {
        text: `$${searchQuery} looking strong today! 🚀`,
        author: 'cryptotrader',
        followers: 50000,
        sentiment: 'bullish',
      },
    ],
  }
}
```

